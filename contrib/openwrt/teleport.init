#!/bin/sh /etc/rc.common
# Teleport SSH agent for OpenWrt (procd)
#
# 装法:
#   cp teleport.init /etc/init.d/teleport && chmod 755 /etc/init.d/teleport
#   /etc/init.d/teleport enable && /etc/init.d/teleport start
#
# ⚠️ 固件升级会清掉 overlay。二进制放在外挂盘上不受影响, 但本脚本和它的
#    启动软链在 overlay 里, 必须加进 /etc/sysupgrade.conf:
#      echo /etc/init.d/teleport   >> /etc/sysupgrade.conf
#      echo /etc/rc.d/S95teleport  >> /etc/sysupgrade.conf

USE_PROCD=1
START=95
STOP=10

PREFIX=/mnt/sata2-4/apps/teleport
PROG="$PREFIX/bin/teleport"
CONF="$PREFIX/teleport.yaml"

start_service() {
    # 外挂盘挂载晚于本脚本时直接放弃, 交给 procd respawn 重试。
    # 一般不会发生: fstab 是 START=11, 远早于这里的 95。
    [ -x "$PROG" ] || { echo "teleport: $PROG 不可执行(外挂盘未挂载?)"; return 1; }
    [ -f "$CONF" ] || { echo "teleport: 找不到 $CONF"; return 1; }

    procd_open_instance
    procd_set_param command "$PROG" start --config="$CONF"
    procd_set_param respawn 3600 10 0
    procd_set_param limits nofile="8192 8192"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
